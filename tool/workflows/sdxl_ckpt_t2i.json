{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "{MODEL_CKPT}" }
  },
  "7": {
    "class_type": "LoraLoader",
    "inputs": { "model": ["1", 0], "clip": ["1", 1], "lora_name": "{XL_LORA1}", "strength_model": {XL_LORA1_STR}, "strength_clip": 1.0 }
  },
  "8": {
    "class_type": "LoraLoader",
    "inputs": { "model": ["7", 0], "clip": ["7", 1], "lora_name": "{XL_LORA2}", "strength_model": {XL_LORA2_STR}, "strength_clip": 1.0 }
  },
  "14": {
    "class_type": "LoraLoader",
    "inputs": { "model": ["8", 0], "clip": ["8", 1], "lora_name": "{XL_LORA3}", "strength_model": {XL_LORA3_STR}, "strength_clip": 1.0 }
  },
  "15": {
    "class_type": "LoraLoader",
    "inputs": { "model": ["14", 0], "clip": ["14", 1], "lora_name": "{XL_LORA4}", "strength_model": {XL_LORA4_STR}, "strength_clip": 1.0 }
  },
  "16": {
    "class_type": "LoraLoader",
    "inputs": { "model": ["15", 0], "clip": ["15", 1], "lora_name": "{XL_LORA5}", "strength_model": {XL_LORA5_STR}, "strength_clip": 1.0 }
  },
  "17": {
    "class_type": "LoraLoader",
    "inputs": { "model": ["16", 0], "clip": ["16", 1], "lora_name": "{XL_LORA6}", "strength_model": {XL_LORA6_STR}, "strength_clip": 1.0 }
  },
  "6": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": {WIDTH}, "height": {HEIGHT}, "batch_size": 1 }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["17", 1], "text": "{PROMPT}" }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["17", 1], "text": "{NEGATIVE}" }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["17", 0], "seed": {SEED}, "steps": {STEPS}, "cfg": {CFG},
      "sampler_name": "{SAMPLER}", "scheduler": "{SCHEDULER}",
      "positive": ["4", 0], "negative": ["5", 0],
      "latent_image": ["6", 0], "denoise": 1.0
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["9", 0], "vae": ["1", 2] }
  },
  "11": {
    "class_type": "SaveImage",
    "inputs": { "images": ["10", 0], "filename_prefix": "kinoloom/ckpt_{SHOT_ID}" }
  }
}
