{
  "1": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "{VIDEO_NAME}",
      "force_rate": 0,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 0,
      "skip_first_frames": 0,
      "select_every_nth": 1
    }
  },
  "2": {
    "class_type": "RIFE VFI",
    "inputs": {
      "frames": ["1", 0],
      "ckpt_name": "rife47.pth",
      "clear_cache_after_n_frames": 10,
      "multiplier": 2,
      "fast_mode": true,
      "ensemble": false,
      "scale_factor": 1.0,
      "dtype": "float32",
      "torch_compile": false,
      "batch_size": 4
    }
  },
  "3": {
    "class_type": "UpscaleModelLoader",
    "inputs": { "model_name": "{ESRGAN_MODEL}" }
  },
  "4": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": { "upscale_model": ["3", 0], "image": ["2", 0] }
  },
  "5": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["4", 0],
      "frame_rate": {FPS},
      "loop_count": 0,
      "filename_prefix": "{OUT_PREFIX}",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}