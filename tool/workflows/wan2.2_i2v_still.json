{
  "1": {
    "class_type": "UnetLoaderGGUF",
    "inputs": { "unet_name": "{MODEL_5B}", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": { "model": ["1", 0], "lora_name": "{LORA_TURBO}", "strength_model": 1.0 }
  },
  "3": {
    "class_type": "ModelSamplingSD3",
    "inputs": { "model": ["2", 0], "shift": 8.0 }
  },
  "4": {
    "class_type": "CLIPLoaderGGUF",
    "inputs": { "clip_name": "{T5}", "type": "wan" }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "{VAE_WAN22}" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["4", 0], "text": "{PROMPT}" }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["4", 0], "text": "{NEGATIVE}" }
  },
  "8": {
    "class_type": "LoadImage",
    "inputs": { "image": "{START_IMAGE}" }
  },
  "9": {
    "class_type": "Wan22ImageToVideoLatent",
    "inputs": { "vae": ["5", 0], "start_image": ["8", 0], "width": 768, "height": 768, "length": 1, "batch_size": 1 }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["3", 0], "seed": {SEED}, "steps": 12, "cfg": 1.0,
      "sampler_name": "euler", "scheduler": "simple",
      "positive": ["6", 0], "negative": ["7", 0],
      "latent_image": ["9", 0], "denoise": {DENOISE}
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["10", 0], "vae": ["5", 0] }
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": { "images": ["11", 0], "filename_prefix": "kinoloom/var_{SHOT_ID}" }
  }
}
