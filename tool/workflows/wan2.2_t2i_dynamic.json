{
  "1": {
    "class_type": "UnetLoaderGGUF",
    "inputs": { "unet_name": "{MODEL_5B}", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "LoraChain",
    "inputs": { "model": ["1", 0], "loras": {LORA_CHAIN} }
  },
  "3": {
    "class_type": "ModelSamplingSD3",
    "inputs": { "model": ["2", 0], "shift": 8.0 }
  },
  "4": {
    "class_type": "{T5_LOADER}",
    "inputs": { "clip_name": "{T5_FILE}", "type": "wan" }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "{VAE_WAN22}" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["4", 0], "text": "{PROMPT}" }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["4", 0], "text": "{NEGATIVE}" }
  },
  "8": {
    "class_type": "Wan22ImageToVideoLatent",
    "inputs": { "vae": ["5", 0], "width": {WIDTH}, "height": {HEIGHT}, "length": 1, "batch_size": 1 }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["3", 0], "seed": {SEED}, "steps": {STEPS}, "cfg": 1.0,
      "sampler_name": "euler", "scheduler": "simple",
      "positive": ["6", 0], "negative": ["7", 0],
      "latent_image": ["8", 0], "denoise": 1.0
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["9", 0], "vae": ["5", 0] }
  },
  "11": {
    "class_type": "SaveImage",
    "inputs": { "images": ["10", 0], "filename_prefix": "kinoloom/t2i_{SHOT_ID}" }
  }
}
